<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Whole-session backstop: 60 min -->
    <ResultsDirectory>src\bin\e2e\TestResults</ResultsDirectory>
    <TestSessionTimeout>3600000</TestSessionTimeout>
  </RunConfiguration>

  <!-- Blame hang detection: if a single test runs for 15 min, dump + name the hung test, then terminate -->
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="blame" enabled="True" />
    </Loggers>
  </LoggerRunSettings>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame" enabled="True">
        <Configuration>
          <!-- 15 min for a single test (setup + test + retries) => considered hung -->
          <CollectDumpOnTestSessionHang TestTimeout="900000" HangDumpType="None" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>