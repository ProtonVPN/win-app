<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Whole-session backstop: 43 min -->
    <ResultsDirectory>src\bin\e2e\TestResults</ResultsDirectory>
    <TestSessionTimeout>2580000</TestSessionTimeout>
  </RunConfiguration>

  <!-- Blame hang detection: if no test activity for 7 min, dump + name the hung test, then terminate -->
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="blame" enabled="True" />
    </Loggers>
  </LoggerRunSettings>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame" enabled="True">
        <Configuration>
          <!-- 7 min of no progress => considered hung -->
          <CollectDumpOnTestSessionHang TestTimeout="420000" HangDumpType="None" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>