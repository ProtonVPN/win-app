<UserControl x:Class="ProtonVPN.Client.UI.Main.Home.Card.Feedback.ConnectionFeedbackComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CommunityToolkit.WinUI.Controls"
             xmlns:custom="using:ProtonVPN.Client.Common.UI.Controls.Custom"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="using:ProtonVPN.Client.UI.Main.Home.Card.DefaultConnections"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathicons="using:ProtonVPN.Client.Common.UI.Assets.Icons.PathIcons"
             xmlns:animations="using:ProtonVPN.Client.Common.UI.Assets.Animations"
             x:DefaultBindMode="OneWay"
             AutomationProperties.AutomationId="ConnectionFeedbackComponent"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Visibility="{x:Bind ViewModel.IsConnectionFeedbackVisible}"
          Margin="0,16,0,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{x:Bind ViewModel.Localizer.Get('Connection_Feedback_Question')}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextWeakColorBrush}"
                   VerticalAlignment="Center"
                   Grid.Column="0"
                   x:Name="ConnectionFeedbackText"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="ConnectionFeedbackTextTransform" 
                                    Y="-8" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <custom:GhostButton Grid.Column="2"
                            Padding="0"
                            Margin="0,4,0,0"
                            Command="{x:Bind ViewModel.ReportPoorConnectionCommand, Mode=OneTime}"
                            x:Name="ConnectionFeedbackThumbsDownButton"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0">
            <custom:GhostButton.RenderTransform>
                <TranslateTransform x:Name="ConnectionFeedbackThumbsDownButtonTransform"
                                    Y="-8" />
            </custom:GhostButton.RenderTransform>
            <custom:GhostButton.LeftIcon>
                <AnimatedIcon Foreground="{ThemeResource TextNormColorBrush}">
                    <animations:ThumbsDownAnimatedIcon />
                </AnimatedIcon>
            </custom:GhostButton.LeftIcon>
        </custom:GhostButton>

        <custom:GhostButton Grid.Column="3"
                            Padding="0"
                            Margin="0,0,0,2"
                            Command="{x:Bind ViewModel.ReportGoodConnectionCommand, Mode=OneTime}"
                            x:Name="ConnectionFeedbackThumbsUpButton"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0">
            <custom:GhostButton.RenderTransform>
                <TranslateTransform x:Name="ConnectionFeedbackThumbsUpButtonTransform"
                                    Y="-8" />
            </custom:GhostButton.RenderTransform>
            <custom:GhostButton.LeftIcon>
                <AnimatedIcon Foreground="{ThemeResource TextNormColorBrush}">
                    <animations:ThumbsUpAnimatedIcon />
                </AnimatedIcon>
            </custom:GhostButton.LeftIcon>
        </custom:GhostButton>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FeedbackStates">

                <VisualState x:Name="Hidden" />

                <VisualState x:Name="SendingFeedback">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsSendingFeedback}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionFeedbackText.Opacity" Value="1" />
                        <Setter Target="ConnectionFeedbackTextTransform.Y" Value="0" />
                        <Setter Target="ConnectionFeedbackThumbsDownButton.Opacity" Value="1" />
                        <Setter Target="ConnectionFeedbackThumbsDownButtonTransform.Y" Value="0" />
                        <Setter Target="ConnectionFeedbackThumbsUpButton.Opacity" Value="1" />
                        <Setter Target="ConnectionFeedbackThumbsUpButtonTransform.Y" Value="0" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                         Storyboard.TargetProperty="Opacity"
                                         BeginTime="0:0:0.5"
                                         To="0"
                                         Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Visible">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsConnectionFeedbackVisible}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Opacity" Value="1" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ConnectionFeedbackText"
                                         Storyboard.TargetProperty="Opacity"
                                         BeginTime="0:0:1.0"
                                         To="1"
                                         Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ConnectionFeedbackTextTransform"
                                         Storyboard.TargetProperty="Y"
                                         To="0"
                                         BeginTime="0:0:1.0"
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation Storyboard.TargetName="ConnectionFeedbackThumbsDownButton"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         BeginTime="0:0:1.1"
                                         Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ConnectionFeedbackThumbsDownButtonTransform"
                                         Storyboard.TargetProperty="Y"
                                         To="0"
                                         BeginTime="0:0:1.1"
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation Storyboard.TargetName="ConnectionFeedbackThumbsUpButton"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         BeginTime="0:0:1.15"
                                         Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ConnectionFeedbackThumbsUpButtonTransform"
                                         Storyboard.TargetProperty="Y"
                                         To="0"
                                         BeginTime="0:0:1.15"
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>

</UserControl>
